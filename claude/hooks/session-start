#!/usr/bin/env bash
# SessionStart hook - injects session-handling skill content at session start

set -euo pipefail

# Determine the .claude root directory from this script's location
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
CLAUDE_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read session-handling skill content
skill_content=$(cat "${CLAUDE_ROOT}/skills/flow-session-handling/SKILL.md" 2>&1 || echo "Error: could not read session-handling skill")

# Escape string for JSON embedding
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

skill_escaped=$(escape_for_json "$skill_content")
session_context="<EXTREMELY_IMPORTANT>\n**Below is the full content of your 'session-handling' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${skill_escaped}\n</EXTREMELY_IMPORTANT>"

cat <<EOF
{
  "systemMessage": "✓ session-handling skill injected",
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${session_context}"
  }
}
EOF

exit 0
